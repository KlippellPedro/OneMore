NAME=OneMore
TYPE=site
ID=onemore
MAIN=servidor.js
# sem BUILD: o site/ vai compilado no pacote (npm run build:site antes de subir).
# A Discloud roda `npm run build --if-present` no deploy, e por isso NAO existe
# script `build` no package.json - ele apagaria o site/ enviado. Ver o README.
RAM=512
VERSION=latest
AUTORESTART=true
START=node servidor.js
