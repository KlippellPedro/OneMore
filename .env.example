# Copie pra .env (mesma pasta do discloud.config) e preencha.
# O .env serve so pro desenvolvimento local: NAO sobe pra Discloud (esta no
# .discloudignore) nem vai pro git. Em producao, as mesmas variaveis ficam em
# Variaveis, no painel do app.

# String de conexao do Postgres.
# Na Discloud: painel -> Templates -> PostgreSQL -> provisione e copie a
# connection string que aparece depois de hospedar.
DATABASE_URL=postgres://usuario:senha@host:5432/onemore

# 1 = exige TLS no banco. Deixe vazio pro Postgres interno da Discloud
# (rede interna, sem TLS). Ligue se usar banco externo (Neon, Railway...).
PGSSL=

# 1 = marca o cookie de sessao como Secure mesmo sem o cabecalho
# x-forwarded-proto. Ligue em producao (a Discloud serve https);
# deixe vazio no desenvolvimento, senao o cookie nao gruda no localhost.
PRODUCAO=1

# NAO coloque PORT aqui nem nas Variaveis da Discloud: ela espera 8080 num
# TYPE=site, e um valor errado derruba o site. Pra rodar local em outra porta:
# npm run servidor:local
